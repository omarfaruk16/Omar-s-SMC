# Django Settings
SECRET_KEY=django-insecure-your-local-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Environment Mode (development or production)
MODE=development

# CSRF Settings
# List of origins allowed to make cross-site requests
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Database Configuration
# SQLite is used automatically in development mode
DB_USER=omar
DB_PASSWORD=omarsstrongpassword123
DB_NAME=smsp
DB_HOST=localhost
DB_PORT=5432

# CORS Settings
# Allowed origins for Cross-Origin Resource Sharing (frontend domain)
# This must include the frontend domain or requests will be blocked
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_BASE_URL=http://localhost:3000

# Email Settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@schoolsms.com
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# SSLCOMMERZ Settings (Sandbox)
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASSWORD=your_store_password
SSLCOMMERZ_SANDBOX=True
SSLCOMMERZ_SUCCESS_URL=http://localhost:3000/payment/success
SSLCOMMERZ_FAIL_URL=http://localhost:3000/payment/fail
SSLCOMMERZ_CANCEL_URL=http://localhost:3000/payment/cancel
SSLCOMMERZ_IPN_URL=http://localhost:8000/api/payments/sslcommerz/ipn/
SSLCOMMERZ_TRANSCRIPT_IPN_URL=http://localhost:8000/api/transcripts/sslcommerz/ipn/
SSLCOMMERZ_TESTIMONIAL_IPN_URL=http://localhost:8000/api/testimonials/sslcommerz/ipn/
SSLCOMMERZ_ADMISSION_IPN_URL=http://localhost:8000/api/admissions/sslcommerz/ipn/
SSLCOMMERZ_CURRENCY=BDT

# Fee Amounts (in BDT)
ADMISSION_FORM_FEE_AMOUNT=3500
TRANSCRIPT_FEE_AMOUNT=3500
TESTIMONIAL_FEE_AMOUNT=3500

# Web Push (VAPID)
WEBPUSH_PUBLIC_KEY=your_public_key
WEBPUSH_PRIVATE_KEY=your_private_key
WEBPUSH_SUBJECT=mailto:admin@example.com

SECRET_KEY=replace-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_BASE_URL=http://localhost:3000

# Environment Mode (development or production)
# Set to 'development' to use SQLite, 'production' to use PostgreSQL
MODE=development

# Database Configuration (used in production mode)
# For development mode: SQLite is used automatically
# For production mode: PostgreSQL configuration required
DB_USER=omar
DB_PASSWORD=your-strong-password-here
DB_NAME=smsp
DB_HOST=localhost
DB_PORT=5432

# SSLCOMMERZ
SSLCOMMERZ_SANDBOX=true
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX_STORE_ID=
SSLCOMMERZ_SANDBOX_STORE_PASSWORD=
SSLCOMMERZ_LIVE_STORE_ID=
SSLCOMMERZ_LIVE_STORE_PASSWORD=
SSLCOMMERZ_SUCCESS_URL=http://localhost:3000/payment/success
SSLCOMMERZ_FAIL_URL=http://localhost:3000/payment/fail
SSLCOMMERZ_CANCEL_URL=http://localhost:3000/payment/cancel
SSLCOMMERZ_IPN_URL=http://localhost:8000/api/payments/sslcommerz/ipn/
SSLCOMMERZ_TRANSCRIPT_IPN_URL=http://localhost:8000/api/transcripts/sslcommerz/ipn/
SSLCOMMERZ_TESTIMONIAL_IPN_URL=http://localhost:8000/api/testimonials/sslcommerz/ipn/
SSLCOMMERZ_ADMISSION_IPN_URL=http://localhost:8000/api/admissions/sslcommerz/ipn/
SSLCOMMERZ_CURRENCY=BDT
TRANSCRIPT_FEE_AMOUNT=3500
TESTIMONIAL_FEE_AMOUNT=3500
ADMISSION_FORM_FEE_AMOUNT=3500

# Web Push (VAPID)
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=
WEBPUSH_SUBJECT=mailto:admin@example.com

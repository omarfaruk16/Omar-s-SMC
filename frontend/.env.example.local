# Frontend Configuration - Local Development
# API endpoint (local backend)
REACT_APP_API_URL=http://localhost:8000/api

# Backend base URL for media/static files
REACT_APP_BACKEND_URL=http://localhost:8000

# SSLCOMMERZ Payment Gateway
# Set to true for sandbox/testing
REACT_APP_SSLCOMMERZ_SANDBOX=true

# Payment Fee Amounts (in BDT, smallest unit - taka * 100)
REACT_APP_TESTIMONIAL_FEE_AMOUNT=3500
REACT_APP_ADMISSION_FORM_FEE_AMOUNT=3500
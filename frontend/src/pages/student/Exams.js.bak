import React, { useEffect, useMemo, useState } from 'react';
import { Link } from 'react-router-dom';
import { examAPI } from '../../services/api';
import { useToast } from '../../context/ToastContext';

const PAGE_SIZE = 6;

const StudentExams = () => {
  const toast = useToast();
  const [exams, setExams] = useState([]);
  const [loading, setLoading] = useState(true);
  const [page, setPage] = useState(1);

  useEffect(() => {
    const load = async () => {
      try {
        setLoading(true);
        const examRes = await examAPI.getAll();
        setExams(examRes.data || []);
      } catch (error) {
        console.error(error);
        toast.error('Failed to load exams');
      } finally {
        setLoading(false);
      }
    };
    load();
  }, [toast]);

  const groupedExams = useMemo(() => {
    const map = new Map();
    exams.forEach((exam) => {
      const key = exam.batch_id || `${exam.class_assigned}-${exam.title || 'routine'}`;
      if (!map.has(key)) {
        map.set(key, {
          key,
          batch_id: exam.batch_id,
          class_id: exam.class_assigned,
          class_name: exam.class_name,
          title: exam.title || 'Exam Routine',
          subjects: [],
          result_status: 'pending',
          exam_ids: [],
        });
      }
      const group = map.get(key);
      group.exam_ids.push(exam.id);
      group.subjects.push({
        name: exam.subject_name || '—',
        date: exam.date,
        start_time: exam.start_time,
        end_time: exam.end_time,
      });
      if (exam.result_status === 'published') {
        group.result_status = 'published';
      }
    });
    return Array.from(map.values());
  }, [exams]);

  const totalPages = Math.max(1, Math.ceil(groupedExams.length / PAGE_SIZE));
  const currentPage = Math.min(page, totalPages);
  const pageItems = groupedExams.slice((currentPage - 1) * PAGE_SIZE, currentPage * PAGE_SIZE);

  const downloadRoutine = async (group) => {
    try {
      const response = await examAPI.downloadRoutine({
        batch_id: group.batch_id,
        class_id: group.class_id,
      });
      const blob = new Blob([response.data], { type: 'application/pdf' });
      const url = window.URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.setAttribute('download', `exam-routine-${group.class_name}.pdf`);
      document.body.appendChild(link);
      link.click();
      link.remove();
      window.URL.revokeObjectURL(url);
    } catch (error) {
      console.error('Failed to download routine', error);
      toast.error('Unable to download routine');
    }
  };

  if (loading) {
    return (
      <div className="min-h-screen bg-gray-50 py-8 flex items-center justify-center">
        <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600" />
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-gray-50 py-8">
      <div className="container mx-auto px-4">
        <div className="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
          <div>
            <h1 className="text-3xl font-bold text-gray-900">Exams & Results</h1>
            <p className="text-sm text-gray-600 mt-1">Download exam routines and check published results.</p>
          </div>
        </div>

        <div className="bg-white rounded-lg shadow-md overflow-hidden">
          {groupedExams.length === 0 ? (
            <div className="p-8 text-center text-gray-500">No exams scheduled yet.</div>
          ) : (
            <div className="overflow-x-auto">
              <table className="min-w-full divide-y divide-gray-200 text-sm">
                <thead className="bg-gray-50">
                  <tr>
                    <th className="px-6 py-3 text-left font-medium text-gray-500 uppercase">Exam</th>
                    <th className="px-6 py-3 text-left font-medium text-gray-500 uppercase">Class</th>
                    <th className="px-6 py-3 text-left font-medium text-gray-500 uppercase">Subjects</th>
                    <th className="px-6 py-3 text-left font-medium text-gray-500 uppercase">Result Status</th>
                    <th className="px-6 py-3 text-left font-medium text-gray-500 uppercase">Actions</th>
                  </tr>
                </thead>
                <tbody className="bg-white divide-y divide-gray-200">
                  {pageItems.map((group) => {
                    const resultQuery = group.batch_id
                      ? `batch_id=${group.batch_id}`
                      : `exam_id=${group.exam_ids[0]}`;
                    return (
                      <tr key={group.key}>
                        <td className="px-6 py-4">
                          <div className="font-semibold text-gray-900">{group.title}</div>
                          <div className="text-xs text-gray-500">{group.subjects.length} subjects</div>
                        </td>
                        <td className="px-6 py-4 text-gray-600">{group.class_name}</td>
                        <td className="px-6 py-4 text-gray-600">
                          {group.subjects.map((subject, idx) => (
                            <div key={`${group.key}-${idx}`}>
                              {subject.name} · {subject.date || 'TBA'}{subject.start_time ? ` · ${subject.start_time}${subject.end_time ? ` - ${subject.end_time}` : ''}` : ''}
                            </div>
                          ))}
                        </td>
                        <td className="px-6 py-4">
                          <span className={`px-2 py-1 rounded-full text-xs font-semibold ${group.result_status === 'published' ? 'bg-emerald-100 text-emerald-700' : 'bg-amber-100 text-amber-700'}`}>
                            {group.result_status === 'published' ? 'Published' : 'Pending'}
                          </span>
                        </td>
                        <td className="px-6 py-4 space-x-2">
                          <button
                            type="button"
                            onClick={() => downloadRoutine(group)}
                            className="px-3 py-1 bg-emerald-600 text-white rounded"
                          >
                            Download Routine
                          </button>
                          {group.result_status === 'published' ? (
                            <Link
                              to={`/student/exams/results?${resultQuery}`}
                              className="inline-flex items-center px-3 py-1 bg-blue-600 text-white rounded"
                            >
                              Check Result
                            </Link>
                          ) : (
                            <span className="text-gray-400">—</span>
                          )}
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          )}
        </div>

        {groupedExams.length > PAGE_SIZE && (
          <div className="flex items-center justify-between mt-6">
            <button
              type="button"
              onClick={() => setPage((p) => Math.max(1, p - 1))}
              disabled={currentPage === 1}
              className="px-4 py-2 bg-gray-200 text-gray-700 rounded disabled:opacity-50"
            >
              Previous
            </button>
            <div className="text-sm text-gray-600">Page {currentPage} of {totalPages}</div>
            <button
              type="button"
              onClick={() => setPage((p) => Math.min(totalPages, p + 1))}
              disabled={currentPage === totalPages}
              className="px-4 py-2 bg-gray-200 text-gray-700 rounded disabled:opacity-50"
            >
              Next
            </button>
          </div>
        )}
      </div>
    </div>
  );
};

export default StudentExams;

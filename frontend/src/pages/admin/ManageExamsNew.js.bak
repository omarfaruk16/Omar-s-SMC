import React, { useEffect, useMemo, useState } from 'react';
import { examAPI, classAPI, subjectAPI } from '../../services/api';
import { useToast } from '../../context/ToastContext';
import Modal from '../../components/Modal';

const ManageExamsNew = () => {
  const toast = useToast();
  const [exams, setExams] = useState([]);
  const [classes, setClasses] = useState([]);
  const [subjects, setSubjects] = useState([]);
  const [loading, setLoading] = useState(true);
  const [selectedClass, setSelectedClass] = useState('');
  const [subjectEntries, setSubjectEntries] = useState([]);
  const [confirmOpen, setConfirmOpen] = useState(false);
  const [confirmList, setConfirmList] = useState([]);
  const [submitting, setSubmitting] = useState(false);

  useEffect(() => { load(); }, []);

  const load = async () => {
    try {
      setLoading(true);
      const [eRes, cRes, sRes] = await Promise.all([
        examAPI.getAll(),
        classAPI.getAll(),
        subjectAPI.getAll(),
      ]);
      setExams(eRes.data || []);
      setClasses(cRes.data || []);
      setSubjects(sRes.data || []);
    } catch (e) {
      console.error(e);
      toast.error('Failed to load exams');
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    if (!selectedClass) {
      setSubjectEntries([]);
      return;
    }
    const list = subjects
      .filter((s) => (s.classes || []).includes(Number(selectedClass)))
      .map((s) => ({
        subject_id: s.id,
        name: s.name,
        code: s.code,
        date: '',
        start_time: '',
        end_time: '',
      }));
    setSubjectEntries(list);
  }, [selectedClass, subjects]);

  const groupedExams = useMemo(() => {
    const map = new Map();
    exams.forEach((exam) => {
      const key = exam.batch_id || `${exam.class_assigned}-${exam.title || 'routine'}`;
      if (!map.has(key)) {
        map.set(key, {
          key,
          title: exam.title || 'Exam Routine',
          class_name: exam.class_name,
          class_id: exam.class_assigned,
          batch_id: exam.batch_id,
          created_at: exam.created_at,
          result_status: exam.result_status,
          subjects: [],
        });
      }
      map.get(key).subjects.push(exam.subject_name || '—');
    });
    return Array.from(map.values());
  }, [exams]);

  const updateEntry = (index, field, value) => {
    setSubjectEntries((prev) => {
      const next = [...prev];
      next[index] = { ...next[index], [field]: value };
      return next;
    });
  };

  const missingSubjects = (entries) => entries.filter((e) => !e.date || !e.start_time || !e.end_time);

  const handleSubmit = async () => {
    if (!selectedClass) {
      toast.error('Select a class');
      return;
    }
    const missing = missingSubjects(subjectEntries);
    if (missing.length > 0) {
      setConfirmList(missing.map((m) => m.name));
      setConfirmOpen(true);
      return;
    }
    await submitEntries();
  };

  const submitEntries = async () => {
    if (submitting) return;
    setSubmitting(true);
    try {
      const payload = {
        class_assigned: Number(selectedClass),
        subject_entries: subjectEntries.map((e) => ({
          subject_id: e.subject_id,
          date: e.date || null,
          start_time: e.start_time || null,
          end_time: e.end_time || null,
        })),
      };
      await examAPI.create(payload);
      toast.success('Exam routine saved');
      setSelectedClass('');
      setSubjectEntries([]);
      await load();
    } catch (e) {
      console.error(e);
      toast.error('Failed to create exam routine');
    } finally {
      setSubmitting(false);
      setConfirmOpen(false);
    }
  };

  const downloadRoutine = async (group) => {
    try {
      const response = await examAPI.downloadRoutine({
        batch_id: group.batch_id,
        class_id: group.class_id,
      });
      const blob = new Blob([response.data], { type: 'application/pdf' });
      const url = window.URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.setAttribute('download', `exam-routine-${group.class_name}.pdf`);
      document.body.appendChild(link);
      link.click();
      link.remove();
      window.URL.revokeObjectURL(url);
    } catch (e) {
      console.error(e);
      toast.error('Unable to download routine');
    }
  };

  if (loading) {
    return (
      <div className="min-h-screen bg-gray-50 py-8 flex items-center justify-center">
        <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600"></div>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-gray-50 py-8">
      <div className="container mx-auto px-4">
        <h1 className="text-3xl font-bold text-gray-900 mb-6">Manage Exams</h1>

        <div className="bg-white rounded-lg shadow-md p-6 mb-6">
          <h2 className="text-xl font-bold mb-4">Create Exam Routine</h2>
          <div className="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
            <select value={selectedClass} onChange={(e) => setSelectedClass(e.target.value)} className="px-3 py-2 border rounded">
              <option value="">Select class</option>
              {classes.map((c) => (
                <option key={c.id} value={c.id}>{c.section ? `${c.name} - ${c.section}` : c.name}</option>
              ))}
            </select>
          </div>

          {selectedClass && (
            <div className="overflow-x-auto">
              <table className="min-w-full divide-y divide-gray-200 text-sm">
                <thead className="bg-gray-50">
                  <tr>
                    <th className="px-4 py-3 text-left font-medium text-gray-500 uppercase">Subject</th>
                    <th className="px-4 py-3 text-left font-medium text-gray-500 uppercase">Date</th>
                    <th className="px-4 py-3 text-left font-medium text-gray-500 uppercase">Start Time</th>
                    <th className="px-4 py-3 text-left font-medium text-gray-500 uppercase">End Time</th>
                  </tr>
                </thead>
                <tbody className="bg-white divide-y divide-gray-200">
                  {subjectEntries.map((entry, idx) => (
                    <tr key={entry.subject_id}>
                      <td className="px-4 py-3">
                        <div className="font-medium text-gray-900">{entry.name}</div>
                        <div className="text-xs text-gray-500">Code: {entry.code}</div>
                      </td>
                      <td className="px-4 py-3">
                        <input type="date" value={entry.date} onChange={(e) => updateEntry(idx, 'date', e.target.value)} className="px-2 py-1 border rounded" />
                      </td>
                      <td className="px-4 py-3">
                        <input type="time" value={entry.start_time} onChange={(e) => updateEntry(idx, 'start_time', e.target.value)} className="px-2 py-1 border rounded" />
                      </td>
                      <td className="px-4 py-3">
                        <input type="time" value={entry.end_time} onChange={(e) => updateEntry(idx, 'end_time', e.target.value)} className="px-2 py-1 border rounded" />
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          <div className="mt-4 flex justify-end">
            <button
              type="button"
              onClick={handleSubmit}
              disabled={!selectedClass || submitting}
              className="px-4 py-2 bg-blue-600 text-white rounded disabled:opacity-60"
            >
              {submitting ? 'Saving...' : 'Save Routine'}
            </button>
          </div>
        </div>

        <div className="bg-white rounded-lg shadow-md overflow-hidden">
          {groupedExams.length === 0 ? (
            <div className="p-8 text-center text-gray-500">No exam routines yet.</div>
          ) : (
            <div className="overflow-x-auto">
              <table className="min-w-full divide-y divide-gray-200 text-sm">
                <thead className="bg-gray-50">
                  <tr>
                    <th className="px-6 py-3 text-left font-medium text-gray-500 uppercase">Routine</th>
                    <th className="px-6 py-3 text-left font-medium text-gray-500 uppercase">Class</th>
                    <th className="px-6 py-3 text-left font-medium text-gray-500 uppercase">Subjects</th>
                    <th className="px-6 py-3 text-left font-medium text-gray-500 uppercase">Result Status</th>
                    <th className="px-6 py-3 text-left font-medium text-gray-500 uppercase">Actions</th>
                  </tr>
                </thead>
                <tbody className="bg-white divide-y divide-gray-200">
                  {groupedExams.map((group) => (
                    <tr key={group.key}>
                      <td className="px-6 py-4">
                        <div className="font-semibold text-gray-900">{group.title}</div>
                      </td>
                      <td className="px-6 py-4 text-gray-600">{group.class_name}</td>
                      <td className="px-6 py-4 text-gray-600">{group.subjects.join(', ')}</td>
                      <td className="px-6 py-4">
                        <span className={`px-2 py-1 rounded-full text-xs font-semibold ${group.result_status === 'published' ? 'bg-emerald-100 text-emerald-700' : 'bg-amber-100 text-amber-700'}`}>
                          {group.result_status === 'published' ? 'Published' : 'Pending'}
                        </span>
                      </td>
                      <td className="px-6 py-4">
                        <button
                          type="button"
                          onClick={() => downloadRoutine(group)}
                          className="px-3 py-1 bg-emerald-600 text-white rounded"
                        >
                          Download Routine
                        </button>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </div>
      </div>

      <Modal
        open={confirmOpen}
        onClose={() => setConfirmOpen(false)}
        title="Continue without full routine?"
      >
        <div className="space-y-4">
          <p className="text-sm text-gray-700">
            Some subjects are missing date/time. Continue without creating a full routine?
          </p>
          <ul className="list-disc pl-6 text-sm text-gray-600">
            {confirmList.map((name) => (
              <li key={name}>{name}</li>
            ))}
          </ul>
          <div className="flex justify-end gap-2">
            <button type="button" onClick={() => setConfirmOpen(false)} className="px-4 py-2 rounded bg-gray-200 text-gray-800">
              Cancel
            </button>
            <button type="button" onClick={submitEntries} className="px-4 py-2 rounded bg-blue-600 text-white">
              Continue
            </button>
          </div>
        </div>
      </Modal>
    </div>
  );
};

export default ManageExamsNew;
